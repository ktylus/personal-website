<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="{{ description or site.description }}">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if published else 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="627">
  <meta property="og:image:alt" content="{{ site.name }}, {{ site.role }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/assets/site.css">
  {% if mermaid %}
  <script src="/assets/vendor/mermaid.min.js" defer></script>
  <script src="/assets/mermaid-init.js" defer></script>
  {% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="page">
    <header>
      <a class="site-name" href="/">{{ site.name }}</a>
      {% if site.links.github or site.links.linkedin or site.links.email %}
      <nav aria-label="Social and contact links">
        {% if site.links.github %}<a href="{{ site.links.github }}">GitHub</a>{% endif %}
        {% if site.links.linkedin %}<a href="{{ site.links.linkedin }}">LinkedIn</a>{% endif %}
        {% if site.links.email %}<a href="mailto:{{ site.links.email }}">Email</a>{% endif %}
      </nav>
      {% endif %}
    </header>
    <main id="main">{{ content | safe }}</main>
  </div>
</body>
</html>
