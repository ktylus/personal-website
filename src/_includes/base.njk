<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="{{ description or site.description }}">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="page">
    <header>
      <a class="site-name" href="/">{{ site.name }}</a>
      {% if site.links.github or site.links.linkedin or site.links.email %}
      <nav aria-label="Social and contact links">
        {% if site.links.github %}<a href="{{ site.links.github }}">GitHub</a>{% endif %}
        {% if site.links.linkedin %}<a href="{{ site.links.linkedin }}">LinkedIn</a>{% endif %}
        {% if site.links.email %}<a href="mailto:{{ site.links.email }}">Email</a>{% endif %}
      </nav>
      {% endif %}
    </header>
    <main id="main">{{ content | safe }}</main>
    <footer><span>© {{ site.updated | year }} {{ site.name }}</span><span>Last updated {{ site.updated | readableDate }}</span></footer>
  </div>
</body>
</html>
